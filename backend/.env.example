APP_NAME=PersonalAI
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000"]

# MySQL selected for this local setup; create the database before running init_db.py.
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@localhost:3306/personalai?charset=utf8mb4

# Optional for natural-language chat beyond deterministic P0 actions.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DEFAULT_MODEL=gemini-2.0-flash

# Bot tokens from Telegram BotFather and Discord Developer Portal.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
TELEGRAM_WEBHOOK_URL=

# Optional integrations.
TAVILY_API_KEY=
BRAVE_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
S3_BUCKET=

TIMEZONE_DEFAULT=Asia/Jakarta
